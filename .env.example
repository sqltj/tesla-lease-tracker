# Tesla Lease Tracker — Environment Variables
# Copy to .env and fill in your values

# ─── Tesla API (Databricks Secrets) ───────────────────
# These reference keys inside a Databricks secret scope.
# The app reads them at runtime via the Databricks SDK.
TESLA_LEASE_TRACKER_TESLA_SECRET_SCOPE=tesla-lease-tracker
TESLA_LEASE_TRACKER_TESLA_CLIENT_ID_KEY=tesla-client-id
TESLA_LEASE_TRACKER_TESLA_CLIENT_SECRET_KEY=tesla-client-secret
TESLA_LEASE_TRACKER_TESLA_REFRESH_TOKEN_KEY=tesla-refresh-token

# Tesla API region: "na" (North America), "eu" (Europe), "cn" (China)
TESLA_LEASE_TRACKER_TESLA_API_REGION=na

# ─── Data Persistence ────────────────────────────────
# Path to the JSON file storing lease config and mileage readings
TESLA_LEASE_TRACKER_DATA_FILE_PATH=data/app_data.json
